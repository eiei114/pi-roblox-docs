{
  "name": "pi-roblox-docs",
  "version": "0.3.20",
  "description": "Pi native Roblox documentation tools without a background MCP server.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "roblox",
    "luau",
    "documentation"
  ],
  "license": "MIT",
  "author": "Keisu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eiei114/pi-roblox-docs.git"
  },
  "bugs": {
    "url": "https://github.com/eiei114/pi-roblox-docs/issues"
  },
  "homepage": "https://github.com/eiei114/pi-roblox-docs#readme",
  "files": [
    "extensions/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "ROADMAP.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run smoke:pi && npm run pack:dry",
    "smoke:pi": "node scripts/pi-sdk-smoke.mjs",
    "pack:dry": "npm pack --dry-run",
    "version:check": "node scripts/check-version-bump.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "latest",
    "typebox": "latest",
    "typescript": "latest"
  }
}
